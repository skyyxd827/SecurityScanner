#!/bin/bash
# SecurityScanner 主菜单（手机版）

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # 重置颜色

ANALYZE="$HOME/apk_analysis/analyze.sh"

clear
echo -e "${YELLOW}🛡️  SecurityScanner${NC}"
echo "==================="
echo "1) 扫单个 APK"
echo "2) 批量扫 Download"
echo "3) 查看历史报告"
echo "4) 退出"
echo "-------------------"
read -p "选序号: " opt

case $opt in
  1)
    read -p "APK 路径: " p
    if [ -f "$p" ]; then
      $ANALYZE "$p"
      echo -e "\n${GREEN}✅ 完成${NC}"
    else
      echo -e "${RED}❌ 文件不存在${NC}"
    fi
    ;;
  2)
    echo -e "${YELLOW}⏳ 批量扫描中...${NC}"
    for f in /sdcard/Download/*.apk; do
      [ -f "$f" ] && $ANALYZE "$f"
    done
    echo -e "${GREEN}✅ 批量完成${NC}"
    ;;
  3)
    ls "$HOME/apk_analysis/"
    read -p "输入目录名看 report.json: " d
    if [ -f "$HOME/apk_analysis/$d/report.json" ]; then
      cat "$HOME/apk_analysis/$d/report.json" | jq . 2>/dev/null || cat "$HOME/apk_analysis/$d/report.json"
    else
      echo -e "${RED}❌ 无报告${NC}"
    fi
    ;;
  4)
    echo "Bye"
    exit 0
    ;;
  *)
    echo -e "${RED}❌ 无效${NC}"
    ;;
esac

# 扫描完发通知
termux-notification \
  --title "SecurityScanner" \
  --content "操作完成" \
  --sound 2>/dev/null

read -p "回车返回菜单..."
exec ~/scan.sh

